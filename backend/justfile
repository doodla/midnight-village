# Backend Justfile for Midnight Village
# Run `just` or `just --list` to see available commands

# Use bash with strict error handling
set shell := ["bash", "-uc"]

# Load environment variables from .env file
set dotenv-load

# Default recipe: run all quality checks
default: check

# --- Setup ---

# Install all dependencies (including dev and lint groups)
install:
    uv sync --all-groups

# --- Development ---

# Run development server
dev:
    uv run python manage.py runserver

# Run development server on specific port
serve port="8000":
    uv run python manage.py runserver {{port}}

# Boot the deterministic integration-test harness backend (DEBUG=True,
# throwaway DB) on 127.0.0.1:$HARNESS_PORT, or on a free port it picks and
# prints when HARNESS_PORT is not set: parallel runs never share a port. The
# frontend test-harness recipe passes its own port and waits for
# GET /api/health/ -> 200 before running tests against it.
harness-serve:
    #!/usr/bin/env bash
    set -euo pipefail
    port="${HARNESS_PORT:-}"
    if [ -z "$port" ]; then
      port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
    fi
    echo "[harness-serve] 127.0.0.1:$port"
    # Runs on other ports share the throwaway database: one migrates at a time.
    if command -v flock >/dev/null; then exec 9>"${TMPDIR:-/tmp}/midnight_village_harness.lock"; flock 9; fi
    PGPASSWORD="${DB_PASSWORD:-}" createdb -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" ${DB_USER:+-U "$DB_USER"} midnight_village_harness 2>&1 | grep -v "already exists" || true
    DJANGO_SETTINGS_MODULE=config.settings.harness uv run python manage.py migrate
    if command -v flock >/dev/null; then flock -u 9; exec 9>&-; fi
    exec env DJANGO_SETTINGS_MODULE=config.settings.harness uv run python manage.py runserver --noreload "127.0.0.1:$port"

# Run Django management command
manage *args:
    uv run python manage.py {{args}}

# --- Database ---

# Run migrations
migrate: _env
    uv run python manage.py migrate

# Create new migrations
makemigrations *args:
    uv run python manage.py makemigrations {{args}}

# --- Testing ---

# The suite builds its database from the models (--nomigrations); the migration
# tests (marker `migration`) skip there and run in a second pass that applies the
# real migrations. With arguments only the first pass runs.

# A fresh worktree has no backend/.env: the recipes that use the database write one
# first (tool/ensure_env.sh does nothing when it is there).
_env:
    @../tool/ensure_env.sh

# The whole suite runs on every core (`-n auto`): each worker is its own process, so each
# has its own database (config/test_database.py). With arguments it runs as given, in
# one process.

# Run all tests (and the migration tests when no arguments are given)
test *args: _env
    uv run pytest {{ if args == "" { "-n auto" } else { args } }}
    {{ if args == "" { "just test-migrations" } else { "true" } }}

# Every test on every core, no coverage report: the quick answer while building
# (`just piece-check` at the root uses it)
test-fast: _env
    uv run pytest -n auto --no-cov -q -p no:cacheprovider

# The migration tests, against a database built by the real migrations (no coverage)
test-migrations: _env
    uv run pytest --migrations --create-db --no-cov -m migration

# Re-record contract_samples/ (repo root) from the real server, after a change
# to any payload: review the diff, commit it, and update the app's fixtures if
# a test now fails. `just test` fails while the committed samples are stale.
samples: _env
    UPDATE_CONTRACT_SAMPLES=1 uv run pytest tests/contract/test_contract_samples.py --no-cov -q

# Run tests with coverage report (uses pyproject.toml config)
test-cov: _env
    uv run pytest

# Run tests for specific marker (unit, integration, contract) - no coverage
test-marker marker: _env
    uv run pytest -m {{marker}} --no-cov

# Run unit tests only (no coverage - may have insufficient coverage alone)
test-unit: _env
    uv run pytest -m unit --no-cov

# Run integration tests only (no coverage - may have insufficient coverage alone)
test-integration: _env
    uv run pytest -m integration --no-cov

# Run contract tests only (no coverage - may have insufficient coverage alone)
test-contract: _env
    uv run pytest -m contract --no-cov

# --- Code Quality ---

# `--group lint` makes every run use the ruff in uv.lock. Without it, a checkout set up
# by a plain `uv sync` has no ruff of its own and `uv run ruff` quietly takes whatever
# ruff is on PATH: another version, with other findings than GitHub's.

# Lint code with Ruff
lint:
    uv run --group lint ruff check .

# Lint and fix auto-fixable issues
lint-fix:
    uv run --group lint ruff check . --fix

# Format code with Ruff
format:
    uv run --group lint ruff format .

# Check formatting without making changes
format-check:
    uv run --group lint ruff format . --check

# Type check with Pyrefly. Pyrefly's default excludes skip every file under a
# hidden directory, so a checkout inside one (the repo's own `.claude/worktrees/`)
# would be skipped entirely and fail; the default heuristics are replaced by the
# explicit excludes below.
typecheck:
    uv run --group lint pyrefly check --disable-project-excludes-heuristics --project-excludes '**/node_modules' --project-excludes '**/__pycache__' --project-excludes '**/.venv/**' .

# The settings module only avoids needing a .env: nothing is applied.

# Fail if a model change has no migration
migrations-check:
    DJANGO_SETTINGS_MODULE=config.settings.test uv run python manage.py makemigrations --check --dry-run

# Run all quality checks (lint, format check, typecheck, migrations match models)
check: lint format-check typecheck migrations-check

# Run all quality checks and fix what can be fixed
fix: lint-fix format

# --- Utilities ---

# Create Django superuser
superuser:
    uv run python manage.py createsuperuser

# Show project dependencies tree
deps:
    uv tree

# Shell into Django environment
shell:
    uv run python manage.py shell

# Database shell
dbshell:
    uv run python manage.py dbshell

# Collect static files
collectstatic:
    uv run python manage.py collectstatic --noinput

# Clean up Python cache files
clean:
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    find . -type f -name "*.pyc" -delete 2>/dev/null || true
    find . -type d -name ".pytest_cache" -exec rm -rf {} + 2>/dev/null || true
    find . -type d -name ".ruff_cache" -exec rm -rf {} + 2>/dev/null || true
    find . -type d -name "htmlcov" -exec rm -rf {} + 2>/dev/null || true
    rm -f .coverage coverage.xml 2>/dev/null || true
