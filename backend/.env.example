# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database Configuration
# On macOS with Homebrew PostgreSQL: leave DB_USER and DB_PASSWORD empty to use system user
# On Linux or Docker: set DB_USER=postgres and DB_PASSWORD=postgres (or your credentials)
DB_NAME=midnight_village_dev
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
