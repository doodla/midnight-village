{
  "name": "Live branches: no deleting, no rewinding",
  "target": "branch",
  "source_type": "Repository",
  "source": "doodla/midnight-village",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/live-server",
        "refs/heads/live-app"
      ]
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ],
  "bypass_actors": []
}
