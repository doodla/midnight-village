{
  "name": "Rehearsal: only the release job moves live-rehearsal",
  "target": "branch",
  "source_type": "Repository",
  "source": "doodla/midnight-village",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/live-rehearsal"
      ]
    }
  },
  "rules": [
    { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } }
  ],
  "bypass_actors": [
    { "actor_id": null, "actor_type": "DeployKey", "bypass_mode": "always" }
  ]
}
