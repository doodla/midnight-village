<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One look whatever the phone's dark mode: the night ground from the first
         frame the system draws to the app's own, bars included (no white flash,
         no grey bars). Flutter then runs edge to edge under transparent bars
         (lib/main.dart, systemBarsOver). Android 12 and later: values-v31. -->
    <style name="NightWindow" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- While the app starts (before Android 12): the mark on the night ground,
         the same size and place as Android 12's splash icon. -->
    <style name="LaunchTheme" parent="NightWindow">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter view once it runs. -->
    <style name="NormalTheme" parent="NightWindow">
        <item name="android:windowBackground">@color/night</item>
    </style>
</resources>
