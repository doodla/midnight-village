<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the night ground and the mark in the
     middle, at 192 dp as Android 12's splash shows it. Made by tool/app_icon.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/night" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
