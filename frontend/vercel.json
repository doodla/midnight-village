{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "live-app": true, "**": false } },
  "redirects": [
    {
      "source": "/app",
      "destination": "https://github.com/doodla/midnight-village/releases/download/android-latest/midnight-village.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/((?!assets/|canvaskit/|icons/|zxing/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
