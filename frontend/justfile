# Frontend Justfile for Midnight Village Flutter App
# Run `just` or `just --list` to see available commands

set shell := ["bash", "-uc"]

# Default: show help
default:
    @just --list

# --- Development ---

# Run app on Chrome
run:
    flutter run -d chrome --web-port=3000 --dart-define=ENV=dev

# Run app on specific device
run-device device:
    flutter run -d {{device}} --dart-define=ENV=dev

# Run code generation
gen:
    dart run build_runner build --delete-conflicting-outputs

# Fail when the committed generated code is not what `just gen` makes now
# (about 50 s: CI runs it, the commit gate does not)
gen-check: gen
    git diff --exit-code -- '*.g.dart' '*.freezed.dart'

# Run code generation (watch mode)
watch:
    dart run build_runner watch --delete-conflicting-outputs

# --- Testing ---

# Run all tests (excludes the live-backend e2e harness — see test-harness)
test:
    flutter test --dart-define=ENV=dev --exclude-tags e2e

# Run tests with coverage (excludes the live-backend e2e harness)
test-cov:
    flutter test --dart-define=ENV=dev --coverage --exclude-tags e2e

# Run golden tests only (tagged 'golden'; Linux only, skipped on other OSes)
flutter-test-golden:
    flutter test --dart-define=ENV=dev --tags golden

# Update the golden baselines in test/design_system/goldens/ (Linux only)
flutter-golden-update:
    flutter test --dart-define=ENV=dev --update-goldens --tags golden

# Run integration tests on Chrome (requires Chrome installed)
# Uses flutter drive because flutter test does not support web devices
test-integration:
    flutter drive \
      --dart-define=ENV=dev \
      --driver=test_driver/integration_test.dart \
      --target=integration_test/auth_flow_test.dart \
      -d chrome

# Run integration tests in headless mode for CI
test-integration-ci:
    flutter drive \
      --dart-define=ENV=dev \
      --driver=test_driver/integration_test.dart \
      --target=integration_test/auth_flow_test.dart \
      -d web-server \
      --headless \
      ${CHROME_EXECUTABLE:+--chrome-binary="$CHROME_EXECUTABLE"}

# Boot the real backend harness, replay the reference games through it (API
# runner: all of them; UI runner: a representative subset through the real widget
# tree), write PNG filmstrips + machine-readable failures.jsonl, and exit non-zero
# on any failure. The script tears the backend down on exit. Also available from
# the repo root. See docs/dev/debug-harness/.
test-harness:
    tool/run_harness.sh

# Renders the catalogue in test_screens/ at 390x844 (2x) to build/screens/,
# each next to its mock in build/screens/compare/, and prints a summary of the
# layout overflows, exceptions and (on player screens) reading-floor breaches
# found. No backend; not part of `just test`.
# Usage: just screens [width] [report|strict]
#   just screens             390 wide, findings reported
#   just screens 360         360 wide, into build/screens/w360/
#   just screens 390 strict  exit non-zero when a screen has findings
# A screen whose builder throws always fails the run.
#
# Render every screen to PNG next to its mock
screens width="390" mode="report":
    #!/usr/bin/env bash
    set -euo pipefail
    usage="usage: just screens [width] [report|strict], e.g. just screens 360 strict"
    if [[ ! "{{width}}" =~ ^[1-9][0-9]*$ ]]; then
      echo "just screens: width must be a whole number of logical pixels, got '{{width}}'" >&2
      echo "$usage" >&2
      exit 2
    fi
    case "{{mode}}" in
      report) strict=false ;;
      strict) strict=true ;;
      *) echo "just screens: mode must be 'report' or 'strict', got '{{mode}}'" >&2
         echo "$usage" >&2
         exit 2 ;;
    esac
    flutter test test_screens/screens_test.dart test_screens/screen_gallery_test.dart \
      --reporter expanded \
      --dart-define=ENV=dev \
      --dart-define=SCREENS_WIDTH={{width}} \
      --dart-define=SCREENS_STRICT=$strict

# What a wait and a failed send look like in motion: a tap going busy then
# done, a slow join, a failed send and its retry, a reconnect in a game; each a
# looping WebP (390 wide, under 1.2 MB) in <folder>. No backend.
# Usage: just loading-clips [folder]
loading-clips folder="build/loading_clips_webp":
    flutter test test_screens/loading_clips_test.dart \
      --dart-define=ENV=dev \
      --dart-define=CLIPS_DIR=build/loading_clips
    python3 tool/loading_clips.py build/loading_clips {{folder}}

# The dusk and the dawn in motion: eight frames of each and a strip, to
# <folder>/dusk and <folder>/dawn (test/README.md). No backend.
# Usage: just scene-frames [folder] [label]
scene-frames folder="build/scene_frames" label="after":
    flutter test test_screens/scene_frames_test.dart --reporter expanded \
      --dart-define=ENV=dev \
      --dart-define=SCENE_FRAMES_DIR={{folder}} \
      --dart-define=SCENE_FRAMES_LABEL={{label}}

# The night board's small moments in motion (frontend/test/README.md): a finger
# on a card, the pick, the pick taken back, and the candle across a window, one
# PNG per 17 ms step into <folder>/<label>/pick and /candle. No backend.
# Usage: just night-frames [folder] [label]
night-frames folder="build/night_frames" label="run":
    flutter test test_screens/night_frames_test.dart --reporter expanded \
      --dart-define=ENV=dev \
      --dart-define=NIGHT_FRAMES_DIR={{folder}} \
      --dart-define=NIGHT_FRAMES_LABEL={{label}}

# The cold-read pack (docs/specs/frontend/first-time-play.md): the screens of
# four first-game journeys (host, guest, sleeper, Seer) and a host setting up a
# table for eight before anyone comes (host-sets-8), in order, as one
# phone sees them, to build/playtest/<journey>/screen-NN.png. Hand a folder to
# someone who has never played and ask what they would do next. No backend.
# Usage: just playtest-pack [width]
playtest-pack width="390":
    flutter test test_screens/playtest_pack_test.dart --reporter expanded \
      --dart-define=ENV=dev \
      --dart-define=SCREENS_WIDTH={{width}}

# Regenerate Shadow paper's art in assets/skins/ from docs/design/art/
# (resized). Deterministic. Needs uv.
skin-art:
    uv run --with pillow python tool/skin_art.py

# Regenerate the app icon, the launch marks and the web icons from
# docs/design/art/ (docs/design/app-icon.md). Deterministic. Needs uv.
# Usage: just app-icon [preview-dir]   (a folder: also each candidate's layers)
app-icon preview="":
    uv run --with pillow python tool/app_icon.py {{ if preview == "" { "" } else { "--preview " + preview } }}

# Generate visual diff report from golden test failures
flutter-golden-report *ARGS:
    dart run tool/golden_diff_report.dart {{ARGS}}

# Run golden tests and generate diff report if any fail
flutter-golden-check:
    just flutter-test-golden || just flutter-golden-report

# --- Code Quality ---

# Analyze code; fails on any issue (errors, warnings and infos alike)
analyze:
    flutter analyze

# Format code
format:
    dart format lib test test_screens

# Check formatting (--output=none: report only, never rewrite files)
format-check:
    dart format --output=none --set-exit-if-changed lib test test_screens

# --- Build ---

# A web build with no --dart-define must not contain the /debug toolbar
check-release:
    bash tool/check_release_has_no_debug.sh

# Build for web (production)
build-web:
    flutter build web --dart-define=ENV=prod

# Build for iOS (production)
build-ios:
    flutter build ios --dart-define=ENV=prod

# Build for Android (production)
build-android:
    flutter build appbundle --dart-define=ENV=prod

# --- Utilities ---

# Get dependencies
deps:
    flutter pub get

# Clean build artifacts
clean:
    flutter clean && dart run build_runner clean
